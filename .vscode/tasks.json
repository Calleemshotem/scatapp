{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install All Dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["run", "install-all"],
      "group": {"kind": "build", "isDefault": true},
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Start Both Server and Client",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "group": {"kind": "test", "isDefault": false},
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Start Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "server"],
      "cwd": "${workspaceFolder}/server",
      "group": {"kind": "test", "isDefault": false},
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Start Client",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "cwd": "${workspaceFolder}/client",
      "group": {"kind": "test", "isDefault": false},
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
